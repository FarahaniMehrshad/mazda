<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for pure pieces (no database, no browser, no model).
    Kept out of Mazda.sln on purpose: the API image restores the solution
    and copies only the app projects. Run "dotnet test" in this folder, for
    example inside the mcr.microsoft.com/dotnet/sdk:8.0 image with backend/ mounted.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mazda.Application\Mazda.Application.csproj" />
    <ProjectReference Include="..\..\src\Mazda.Infrastructure\Mazda.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
