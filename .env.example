# ── Required: JWT signing secret (32+ chars) ─────────────────────────
JWT_SECRET=change-me-this-must-be-at-least-32-chars-long

# ── LLM provider (OpenAI-compatible) ─────────────────────────────────
# Mazda speaks the OpenAI Chat Completions API. Point it at any
# compatible endpoint — the wire format is the same.

# OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_ANALYZER_MODEL=gpt-4o-mini
LLM_GENERATOR_MODEL=gpt-4o

# ── Other working configurations ─────────────────────────────────────
# Ollama (local, no real key needed but the SDK requires a non-empty value)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_ANALYZER_MODEL=llama3.1:8b
# LLM_GENERATOR_MODEL=llama3.1:70b

# OpenRouter (one key, hundreds of models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_ANALYZER_MODEL=openai/gpt-4o-mini
# LLM_GENERATOR_MODEL=anthropic/claude-3.5-sonnet

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_ANALYZER_MODEL=deepseek-chat
# LLM_GENERATOR_MODEL=deepseek-coder

# Groq (very fast inference)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_ANALYZER_MODEL=llama-3.1-8b-instant
# LLM_GENERATOR_MODEL=llama-3.3-70b-versatile

# Together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=...
# LLM_ANALYZER_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo
# LLM_GENERATOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# vLLM / LM Studio / llama.cpp (running on this machine)
# LLM_BASE_URL=http://host.docker.internal:8000/v1
# LLM_API_KEY=sk-local
# LLM_ANALYZER_MODEL=your-served-model-name
# LLM_GENERATOR_MODEL=your-served-model-name
