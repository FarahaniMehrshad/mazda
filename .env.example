# ── Required: JWT signing secret (32+ chars) ─────────────────────────
JWT_SECRET=change-me-this-must-be-at-least-32-chars-long

# ── Which LLM ────────────────────────────────────────────────────────
# "openai" (any OpenAI-compatible API, below) or "claude-code" (the Claude Code
# CLI on this computer, see the end of this file). Settings in the UI override
# everything here; this is only the default.
LLM_PROVIDER=openai

# ── LLM provider (OpenAI-compatible) ─────────────────────────────────
# Mazda speaks the OpenAI Chat Completions API. Point it at any
# compatible endpoint — the wire format is the same.

# OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_ANALYZER_MODEL=gpt-4o-mini
LLM_GENERATOR_MODEL=gpt-4o

# How long to wait for one completion. The SDK default is 100s, which is short
# for a large source bundle on a slow or self-hosted model. nginx in the web
# container allows up to 30m for /api/, so anything under that is safe.
LLM_TIMEOUT_SECONDS=600

# ── Other working configurations ─────────────────────────────────────
# Ollama (local, no real key needed but the SDK requires a non-empty value)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_ANALYZER_MODEL=llama3.1:8b
# LLM_GENERATOR_MODEL=llama3.1:70b

# OpenRouter (one key, hundreds of models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_ANALYZER_MODEL=openai/gpt-4o-mini
# LLM_GENERATOR_MODEL=anthropic/claude-3.5-sonnet

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_ANALYZER_MODEL=deepseek-chat
# LLM_GENERATOR_MODEL=deepseek-coder

# Groq (very fast inference)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_ANALYZER_MODEL=llama-3.1-8b-instant
# LLM_GENERATOR_MODEL=llama-3.3-70b-versatile

# Together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=...
# LLM_ANALYZER_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo
# LLM_GENERATOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# vLLM / LM Studio / llama.cpp (running on this machine)
# LLM_BASE_URL=http://host.docker.internal:8000/v1
# LLM_API_KEY=sk-local
# LLM_ANALYZER_MODEL=your-served-model-name
# LLM_GENERATOR_MODEL=your-served-model-name

# ── Claude Code on this computer ─────────────────────────────────────
# Uses your own Claude Code login (subscription); no API key. Mazda runs in
# Docker, so a small bridge on this computer runs `claude -p` for it:
#   1. Create the shared token (both the bridge and the API read it from here):
#        echo "CLAUDE_BRIDGE_TOKEN=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")" >> .env
#   2. docker compose up -d api
#   3. node tools/claude-bridge/bridge.mjs        (keep it running)
#   4. Settings → Language model → "Claude Code on this computer" → Test
# CLAUDE_BRIDGE_TOKEN=
# CLAUDE_BRIDGE_PORT=8787
# CLAUDE_BRIDGE_URL=http://host.docker.internal:8787
# Aliases (sonnet, opus, haiku) or full model ids:
# CLAUDE_ANALYZER_MODEL=sonnet
# CLAUDE_GENERATOR_MODEL=opus
